{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MrLinWang/aliyun-yunxiao-projex-mcp",
  "description": "Alibaba Cloud Yunxiao Projex MCP with self-assignee detection and authenticated file downloads.",
  "version": "0.1.2",
  "websiteUrl": "https://github.com/MrLinWang/yunxiao-projex-mcp",
  "repository": {
    "url": "https://github.com/MrLinWang/yunxiao-projex-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "yunxiao-projex-mcp",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "YUNXIAO_USER_ACCESS_KEY_ID",
          "description": "Yunxiao Bot AccessKey ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "YUNXIAO_USER_ACCESS_KEY_SECRET",
          "description": "Yunxiao Bot AccessKey Secret",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "YUNXIAO_USER_NAME",
          "description": "Yunxiao user display name for self-assignee detection; optional, must match the AccessKey user when set",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "YUNXIAO_API_ORG_ID",
          "description": "Yunxiao organization ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "YUNXIAO_API_PROJECT_ID",
          "description": "Yunxiao Projex project ID",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        },
        {
          "name": "YUNXIAO_API_ENDPOINT",
          "description": "Yunxiao API endpoint; defaults to devops.cn-hangzhou.aliyuncs.com",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "devops.cn-hangzhou.aliyuncs.com"
        }
      ]
    }
  ]
}
